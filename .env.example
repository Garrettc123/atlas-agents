# ATLAS Agents — Environment Variables
# Copy to .env and fill in your keys

# AI Core
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/atlas_production
REDIS_URL=redis://localhost:6379

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+12145550100

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_live_xxxxx

# App
APP_ENV=production
APP_PORT=8000
